# Based on the current Metamod:Source Source2 sample build layout.
import os

project = builder.LibraryProject(MMSPlugin.metadata["name"])

for sdk_target in MMSPlugin.sdk_targets:
  sdk = sdk_target.sdk
  cxx = sdk_target.cxx

  binary = MMSPlugin.HL2Library(builder, cxx, project, sdk)
  binary.sources += [
    'src/plugin.cpp',
    'src/schema_resolver.cpp',
    'src/skin_catalog.cpp',
  ]

  # Built-in menu uses the native TextMsg user message.
  # Generate the current SDK protobuf at build time.
  binary.custom = [builder.tools.Protoc(protoc = sdk_target.protoc, sources = [
    os.path.join(sdk['path'], 'common', 'valveextensions.proto'),
    os.path.join(sdk['path'], 'common', 'network_connection.proto'),
    os.path.join(sdk['path'], 'common', 'networkbasetypes.proto'),
    os.path.join(sdk['path'], 'game', 'shared', 'usermessages.proto'),
  ])]

MMSPlugin.tasks += builder.Add(project)
